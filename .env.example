# ⚠️ 此文件只放占位符，绝不能填真实密钥！真实密钥只放 .env（已在 .gitignore 里排除）。
# 历史教训：本文件曾误填真实密钥，如已发生请立即在 Supabase / 扣子后台轮换。

# Supabase（在 supabase.co 注册后，项目设置 → API 里复制）
# 注意：只填项目根地址，不要带 /rest/v1 后缀（supabase-js 会自己拼）
SUPABASE_URL=https://你的项目ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=你的service_role密钥（只放后端，绝不放前端和仓库）

# 扣子工作流（注册扣子、建好工作流后填写）
# 注意：只填域名，不要带 /v1/workflow/run 路径（代码里会自己拼）
COZE_BASE_URL=https://api.coze.cn
COZE_WORKFLOW_ID=你的工作流ID
COZE_PAT=你的扣子访问令牌

# ---------- Dify 工作流（迁移目标平台，配置后把 AI_PROVIDER 改成 dify 即切换）----------
# AI_PROVIDER=coze        # 当前用哪个平台：coze（默认）/ dify
# DIFY_BASE_URL=https://api.dify.ai   # 自托管填你自己的域名
# DIFY_API_KEY=app_开头的应用API密钥（Dify 应用 → 访问 API → API 密钥）

# JWT 密钥：必须 32 位以上随机字符串。生成命令：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=必填_至少32位随机字符串

# JWT 有效期（可选，默认 7d；想更严格可改 1d、12h 等）
# JWT_TTL=7d

# Supabase 存储桶名称（需在 Supabase 后台先建好，并设为公开）
STORAGE_BUCKET=run-images

# 前后端分域部署时填前端域名白名单（逗号分隔），例如：
# ALLOWED_ORIGINS=https://your-frontend.vercel.app

# 支付默认关闭；仅非生产测试环境才可显式设置 PAY_MODE=mock。
# NODE_ENV=production 时模拟充值始终禁用，正式收费需另行接入真实支付。
# PAY_MODE=off

# 飞书反馈推送（可选，强烈建议配置）：用户提交的意见反馈会实时转发到你的飞书群
# 获取方式：飞书群 → 右上角设置 → 群机器人 → 添加机器人 → 自定义机器人 → 复制 Webhook 地址
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/你的token

# 本地运行端口
PORT=3000

# ---------- 可选调优（不配即用内置默认值）----------
# PDF 导出中转令牌有效期（毫秒），默认 15 分钟
# PDF_SESSION_TTL_MS=900000
# Dify 空闲超时（毫秒），默认 180000
# DIFY_IDLE_TIMEOUT_MS=180000
# Dify 硬超时（毫秒），默认 900000，必须小于僵尸清理线 20 分钟
# DIFY_HARD_TIMEOUT_MS=900000
# 存储签名 URL 有效期（秒），默认 3600
# STORAGE_SIGNED_TTL=3600
# Vercel 环境置 1（本地/自托管不要配）
# VERCEL=0
