      "name": "正确跑姿",
      "icon": "🏃",
      "items": [
        {
          "title": "身体姿态：从头到脚一条线",
          "points": [
            "目视前方 20-30 米，不要低头看脚。低头既增加颈椎负担，也压迫呼吸。",
            "挺胸收腹，躯干微微前倾约 5-10°，前倾来自脚踝，而不是弯腰。",
            "肩膀放松下沉不要耸肩，手肘约 90°，前后摆动，不要越过身体中线。"
          ],
          "note": "跑步时听到自己脚步声很重，多半是落地点在身体重心前方太远，属于「刹车跑」。",
          "media": [
            {
              "src": "learn-media/01-run-form.svg",
              "caption": "跑姿整体循环示范（原创动画）",
              "term": "步态周期 Gait Cycle",
              "benefit": "建立整体省能跑姿的动作记忆，减少制动与落地冲击",
              "muscles": ["核心肌群", "臀中肌", "髂腰肌"],
              "caution": "落地声重＝落点超前于重心，先改落点再谈速度"
            },
            {
              "src": "learn-media/02-run-lean.svg",
              "caption": "从脚踝前倾 vs 弯腰（对比）（原创动画）",
              "term": "踝前倾 Forward Lean",
              "benefit": "借用重力前进而非主动蹬推，省能且步幅自然打开",
              "muscles": ["胫骨前肌", "核心肌群", "臀大肌"],
              "caution": "前倾发自脚踝；弯腰驼背会压迫呼吸、加重腰背负荷"
            }
          ]
        },
        {
          "title": "步频：180 不是硬指标，但越高越省",
          "points": [
            "步频是每分钟脚步落地次数。大众跑者常见 150-165，精英跑者多在 170-185。",
            "步频偏低时，落地点靠前、触地时间长，膝盖承受的冲击更大。",
            "提高 5-10 步/分是低风险高收益的改动，脚下的「砰砰」声会明显变轻。"
          ],
          "note": "不必强求 180。先在当前基础上加 5 步/分，心率不升高为宜，给身体 2-3 周适应。",
          "media": [
            {
              "src": "learn-media/03-run-cadence.svg",
              "caption": "高步频小步幅节奏（原创动画）",
              "term": "步频 Cadence",
              "benefit": "缩短触地时间、降低单步冲击，是低风险的提效改动",
              "muscles": ["小腿三头肌", "髂腰肌"],
              "caution": "每 2-3 周加 5 步/分，心率不升为宜，勿一步到位"
            }
          ]
        },
        {
          "title": "着地方式：别纠结前脚掌，先练「落在重心下方」",
          "points": [
            "着地点尽量靠近身体重心正下方，脚掌轻快过渡，中前脚掌或全脚掌都可以。",
            "脚跟远远伸到身体前方落地 = 刹车 + 冲击直传膝盖，这是伤痛的主要来源之一。",
            "无论哪种着地，落地腿都要保持微屈膝，用肌肉缓冲，而不是用骨头硬扛。"
          ],
          "note": "纯前脚掌跑法对小腿和跟腱要求很高，盲目改造容易引起小腿疼痛，循序渐进。",
          "media": [
            {
              "src": "learn-media/04-run-landing.svg",
              "caption": "脚跟远伸刹车 vs 重心下方缓冲（对比）（原创动画）",
              "term": "着地模式 Foot Strike Pattern",
              "benefit": "落点靠近重心，冲击沿肌肉链缓冲而非直传膝关节",
              "muscles": ["股四头肌", "小腿三头肌"],
              "caution": "不必强求前脚掌，盲目改造易引发小腿与跟腱疼痛"
            }
          ]
        }
      ]
